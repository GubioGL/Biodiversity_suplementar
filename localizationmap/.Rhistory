ggplot2::aes(
ymin = zeta_lcl_norm,
ymax = zeta_ucl_norm
),
alpha = 0.12,
color = NA,
show.legend = FALSE
) +
ggplot2::geom_line(
linewidth = 1.15
) +
ggplot2::geom_point(
size = 3.2,
shape = 21,
stroke = 0.75
) +
ggplot2::scale_color_manual(
values = landscape_colors,
name = "Landscape"
) +
ggplot2::scale_fill_manual(
values = landscape_colors,
name = "Landscape"
) +
ggplot2::scale_y_continuous(
labels = scales::percent_format(
accuracy = 1
),
limits = c(
0,
1.02
),
expand = ggplot2::expansion(
mult = c(
0.01,
0.04
)
)
) +
ggplot2::scale_x_continuous(
breaks = orders_used,
minor_breaks = NULL
) +
ggplot2::labs(
title = "A. Zeta diversity decline",
x = "Zeta order: number of sampling units combined",
y = expression(
"Shared species retained relative to " *
zeta[1]
)
) +
ggplot2::theme_classic(
base_size = 14
) +
ggplot2::theme(
plot.background = ggplot2::element_rect(
fill = "white",
color = NA
),
panel.background = ggplot2::element_rect(
fill = "white",
color = NA
),
panel.border = ggplot2::element_rect(
fill = NA,
color = "black",
linewidth = 0.75
),
axis.line = ggplot2::element_blank(),
axis.text = ggplot2::element_text(
color = "black"
),
axis.title = ggplot2::element_text(
color = "black"
),
plot.title = ggplot2::element_text(
face = "bold",
size = 16,
hjust = 0
),
legend.position = "right",
legend.title = ggplot2::element_text(
face = "bold"
)
)
ratio_plot <- ggplot2::ggplot(
zeta_results |>
dplyr::filter(
order > 1
),
ggplot2::aes(
x = order,
y = zeta_ratio,
color = landscape,
fill = landscape
)
) +
ggplot2::geom_line(
linewidth = 1.15
) +
ggplot2::geom_point(
size = 3.2,
shape = 21,
stroke = 0.75
) +
ggplot2::scale_color_manual(
values = landscape_colors,
name = "Landscape"
) +
ggplot2::scale_fill_manual(
values = landscape_colors,
name = "Landscape"
) +
ggplot2::scale_y_continuous(
labels = scales::percent_format(
accuracy = 1
),
limits = c(
0,
NA
),
expand = ggplot2::expansion(
mult = c(
0.02,
0.08
)
)
) +
ggplot2::scale_x_continuous(
breaks = orders_used[
orders_used > 1
],
minor_breaks = NULL
) +
ggplot2::labs(
title = "B. Zeta retention ratio",
x = "Zeta order",
y = expression(
zeta[i] / zeta[i - 1]
)
) +
ggplot2::theme_classic(
base_size = 14
) +
ggplot2::theme(
plot.background = ggplot2::element_rect(
fill = "white",
color = NA
),
panel.background = ggplot2::element_rect(
fill = "white",
color = NA
),
panel.border = ggplot2::element_rect(
fill = NA,
color = "black",
linewidth = 0.75
),
axis.line = ggplot2::element_blank(),
axis.text = ggplot2::element_text(
color = "black"
),
axis.title = ggplot2::element_text(
color = "black"
),
plot.title = ggplot2::element_text(
face = "bold",
size = 16,
hjust = 0
),
legend.position = "none"
)
zeta_plot <- patchwork::wrap_plots(
decline_plot,
ratio_plot,
widths = c(
1.15,
1
)
) +
patchwork::plot_annotation(
title = paste(
"Zeta diversity of social wasp assemblages",
"across landscapes"
),
subtitle = paste0(
"Computed with zetadiv::Zeta.decline.mc | ",
"Presence/absence matrix from standardized ",
"suspension-trap records | ",
nrow(community_matrix),
" sampling units x ",
ncol(community_matrix),
" species"
),
theme = ggplot2::theme(
plot.title = ggplot2::element_text(
face = "bold",
size = 22,
hjust = 0.5
),
plot.subtitle = ggplot2::element_text(
size = 12.5,
hjust = 0.5
),
plot.background = ggplot2::element_rect(
fill = "white",
color = NA
)
)
)
print(
zeta_plot
)
output_png <- file.path(
output_directory,
"Zeta_diversity_zetadiv_social_wasps_suspension_traps.png"
)
output_tiff <- file.path(
output_directory,
"Zeta_diversity_zetadiv_social_wasps_suspension_traps.tif"
)
output_pdf <- file.path(
output_directory,
"Zeta_diversity_zetadiv_social_wasps_suspension_traps.pdf"
)
output_zeta_csv <- file.path(
output_directory,
"Zeta_diversity_zetadiv_values_social_wasps.csv"
)
output_model_csv <- file.path(
output_directory,
"Zeta_diversity_zetadiv_model_comparison.csv"
)
output_summary <- file.path(
output_directory,
"Zeta_diversity_zetadiv_summary.txt"
)
if (capabilities("cairo")) {
grDevices::png(
filename = output_png,
width = 13.5,
height = 7.8,
units = "in",
res = 1200,
bg = "white",
type = "cairo-png"
)
} else {
grDevices::png(
filename = output_png,
width = 13.5,
height = 7.8,
units = "in",
res = 1200,
bg = "white"
)
}
tryCatch(
{
print(
zeta_plot
)
},
finally = {
grDevices::dev.off()
}
)
grDevices::tiff(
filename = output_tiff,
width = 13.5,
height = 7.8,
units = "in",
res = 1200,
compression = "lzw",
bg = "white"
)
tryCatch(
{
print(
zeta_plot
)
},
finally = {
grDevices::dev.off()
}
)
if (capabilities("cairo")) {
grDevices::cairo_pdf(
filename = output_pdf,
width = 13.5,
height = 7.8,
bg = "white"
)
} else {
grDevices::pdf(
file = output_pdf,
width = 13.5,
height = 7.8,
bg = "white",
useDingbats = FALSE
)
}
tryCatch(
{
print(
zeta_plot
)
},
finally = {
grDevices::dev.off()
}
)
readr::write_csv(
zeta_results,
output_zeta_csv,
na = ""
)
readr::write_csv(
zeta_models,
output_model_csv,
na = ""
)
zetadiv_version <- as.character(
utils::packageVersion(
"zetadiv"
)
)
summary_lines <- capture.output(
{
cat(
"Zeta diversity - social wasps\n"
)
cat(
"Computation: zetadiv::Zeta.decline.mc\n"
)
cat(
"zetadiv version:",
zetadiv_version,
"\n"
)
cat(
"Base: standardized suspension-trap records only\n"
)
cat(
"Matrix: sampling point x species presence/absence\n"
)
cat(
"Sampling unit: point_id from area, latitude and longitude\n"
)
cat(
"Deduplication: species, date and sampling point/location\n"
)
cat(
"Orders:",
paste(
orders_used,
collapse = ", "
),
"\n"
)
cat(
"Monte Carlo samples per order:",
zeta_samples,
"\n\n"
)
cat(
"Input file:\n",
file_csv,
"\n\n",
sep = ""
)
cat(
"Raw file rows:\n",
nrow(raw_data),
"\n\n",
sep = ""
)
cat(
"Raw suspension rows:\n",
nrow(suspension_rows),
"\n\n",
sep = ""
)
cat(
"Deduplicated suspension records:\n",
nrow(suspension_records),
"\n\n",
sep = ""
)
cat(
"Final matrix dimensions:\n"
)
cat(
nrow(community_matrix),
"sampling units x",
ncol(community_matrix),
"species\n\n"
)
cat(
"Sampling units by landscape:\n"
)
print(
units_by_landscape
)
cat(
"\nDeduplicated suspension records by landscape:\n"
)
print(
records_by_landscape
)
cat(
"\nSpecies by landscape:\n"
)
print(
species_by_landscape
)
cat(
"\nZeta values:\n"
)
print(
zeta_results
)
cat(
"\nZeta-decline model comparison:\n"
)
print(
zeta_models
)
cat(
"\nPackage citation:\n"
)
print(
utils::citation(
"zetadiv"
)
)
}
)
writeLines(
summary_lines,
output_summary,
useBytes = TRUE
)
cat(
"\nAnalysis completed.\n\n"
)
cat(
"zetadiv version: ",
zetadiv_version,
"\n\n",
sep = ""
)
cat(
"PNG saved at:\n",
normalizePath(
output_png,
winslash = "/",
mustWork = TRUE
),
"\n\n",
sep = ""
)
cat(
"TIFF saved at:\n",
normalizePath(
output_tiff,
winslash = "/",
mustWork = TRUE
),
"\n\n",
sep = ""
)
cat(
"PDF saved at:\n",
normalizePath(
output_pdf,
winslash = "/",
mustWork = TRUE
),
"\n\n",
sep = ""
)
cat(
"Zeta values saved at:\n",
normalizePath(
output_zeta_csv,
winslash = "/",
mustWork = TRUE
),
"\n\n",
sep = ""
)
cat(
"Model comparison saved at:\n",
normalizePath(
output_model_csv,
winslash = "/",
mustWork = TRUE
),
"\n\n",
sep = ""
)
cat(
"Summary saved at:\n",
normalizePath(
output_summary,
winslash = "/",
mustWork = TRUE
),
"\n",
sep = ""
)
