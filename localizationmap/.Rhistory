x = x,
y = y,
hjust = 0,
vjust = 0,
fontface = "bold",
fontfamily = font_family,
size = font_size[["tag"]]
) +
cowplot::draw_label(
title,
x = x + inches_to_x(0.20),
y = y,
hjust = 0,
vjust = 0,
fontface = "bold",
fontfamily = font_family,
size = font_size[["panel_title"]]
)
}
location_figure <- cowplot::ggdraw() |>
draw_box(
ms_plot,
box_C
) |>
draw_box(
south_america_plot,
box_A
) |>
draw_box(
brazil_plot,
box_B
) |>
draw_box(
