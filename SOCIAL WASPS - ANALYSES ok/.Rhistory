landscape_sequence = landscape_sequence,
species = ordered_species,
crossings = sum(crossing_matrix) / 2,
weighted_crossings = sum(crossing_matrix * outer(links$n_records, links$n_records)) / 2
)
}
candidate_orders <- if (optimize_landscape_order) permutations_of(landscape_order) else list(landscape_order)
arrangements <- lapply(candidate_orders, arrange_network)
landscape_order_scores <- data.frame(
landscape_order = vapply(candidate_orders, paste, character(1), collapse = " > "),
crossings = vapply(arrangements, function(a) a$crossings, numeric(1)),
weighted_crossings = vapply(arrangements, function(a) a$weighted_crossings, numeric(1)),
displacement = vapply(candidate_orders, function(o) sum(abs(match(o, landscape_order) - seq_along(o))), numeric(1)),
stringsAsFactors = FALSE
)
best_arrangement <- order(landscape_order_scores$weighted_crossings, landscape_order_scores$crossings, landscape_order_scores$displacement)[1]
landscape_order_scores$selected <- seq_len(nrow(landscape_order_scores)) == best_arrangement
arrangement <- arrangements[[best_arrangement]]
plot_landscape_order <- arrangement$landscape_sequence
root_images <- list.files(path = image_directory, pattern = "\\.(png|jpg|jpeg|tif|tiff)$", full.names = TRUE, recursive = FALSE, ignore.case = TRUE)
all_images <- list.files(path = image_directory, pattern = "\\.(png|jpg|jpeg|tif|tiff)$", full.names = TRUE, recursive = TRUE, ignore.case = TRUE)
available_images <- unique(c(root_images, all_images))
available_images <- available_images[file.exists(available_images)]
if (length(available_images) > 0) available_images <- available_images[!is_inside_directory(available_images, output_directory)]
available_images <- available_images[!grepl("^Figure_bipartite_", basename(available_images), ignore.case = TRUE)]
landscape_photos <- lapply(plot_landscape_order, function(landscape_label) {
read_landscape_photos(find_landscape_images(image_files = available_images, landscape_label = landscape_label, maximum_number = top_n_images_per_landscape))
})
names(landscape_photos) <- plot_landscape_order
photo_inner_gap_mm <- 0.6
photo_heights <- vapply(
landscape_photos,
function(photos) {
if (length(photos) == 0) return(photo_width_mm * 0.75)
heights <- vapply(photos, function(img) photo_width_mm * dim(img)[1] / dim(img)[2], numeric(1))
sum(heights) + photo_inner_gap_mm * (length(heights) - 1)
},
numeric(1)
)
landscape_info <- links |>
dplyr::group_by(landscape) |>
dplyr::summarise(total_records = sum(n_records), n_species = dplyr::n(), .groups = "drop") |>
dplyr::slice(match(plot_landscape_order, landscape)) |>
dplyr::mutate(photo_height = unname(photo_heights[landscape]))
mm_per_record_limit <- min((landscape_info$photo_height - 2 - landscape_info$n_species * min_ribbon_mm) / landscape_info$total_records)
if (mm_per_record > mm_per_record_limit) mm_per_record <- mm_per_record_limit
ribbon_thickness <- function(n) min_ribbon_mm + mm_per_record * n
species_layout <- arrangement$species |>
dplyr::mutate(
module_number = match(module_raw, unique(module_raw)),
module_label = paste("Module", as.character(utils::as.roman(module_number))),
module_landscape = unname(module_main_landscape[match(module_raw, module_ids)]),
module_color = dplyr::coalesce(unname(landscape_colors[module_landscape]), "grey60"),
bar_height = n_links * min_ribbon_mm + mm_per_record * total_records,
row_height = pmax(species_row_min_mm, bar_height + species_row_padding_mm),
label = format_taxon_label(species)
) |>
dplyr::left_join(species_d_df |> dplyr::rename(species = Species), by = "species")
number_of_modules <- length(unique(species_layout$module_number))
species_block_height <- sum(species_layout$row_height) + module_gap_mm * (number_of_modules - 1)
photo_column_height <- sum(landscape_info$photo_height + photo_label_mm) + photo_gap_mm * (nrow(landscape_info) - 1)
body_height <- max(species_block_height, photo_column_height)
title_height_mm <- if (show_title) 11 else 0
figure_height_mm <- 2 * margin_mm + title_height_mm + header_mm + body_height + footer_mm
body_top <- figure_height_mm - margin_mm - title_height_mm - header_mm
body_bottom <- body_top - body_height
cursor <- body_top - (body_height - species_block_height) / 2
species_layout$row_top <- NA_real_
species_layout$row_bottom <- NA_real_
for (i in seq_len(nrow(species_layout))) {
if (i > 1 && species_layout$module_number[i] != species_layout$module_number[i - 1]) cursor <- cursor - module_gap_mm
species_layout$row_top[i] <- cursor
cursor <- cursor - species_layout$row_height[i]
species_layout$row_bottom[i] <- cursor
}
species_layout <- species_layout |>
dplyr::mutate(
y = (row_top + row_bottom) / 2,
bar_draw_height = pmax(bar_height, 0.5),
bar_ymin = y - bar_draw_height / 2,
bar_ymax = y + bar_draw_height / 2
)
module_layout <- species_layout |>
dplyr::group_by(module_number, module_label, module_color, module_raw) |>
dplyr::summarise(ymax = max(row_top), ymin = min(row_bottom), .groups = "drop") |>
dplyr::mutate(y = (ymin + ymax) / 2)
photo_xmin <- margin_mm
photo_xmax <- photo_xmin + photo_width_mm
landscape_node_xmin <- photo_xmax + 0.8
landscape_node_xmax <- landscape_node_xmin + node_width_mm
module_label_width <- 3.0
module_strip_width <- 1.2
module_strip_xmax <- figure_width_mm - margin_mm - module_label_width
module_strip_xmin <- module_strip_xmax - module_strip_width
dprime_xmax <- module_strip_xmin - 2.0
dprime_xmin <- dprime_xmax - dprime_panel_mm
records_width <- max(measure_label_width_mm(c(as.character(species_layout$total_records), records_header), font_family, small_text_pt, parse = FALSE))
records_x <- dprime_xmin - 3.0
species_label_width <- measure_label_width_mm(species_layout$label, font_family, species_text_pt)
species_label_gap <- 1.5
species_label_x <- records_x - records_width - 2.5 - max(species_label_width)
species_node_xmax <- species_label_x - species_label_gap
species_node_xmin <- species_node_xmax - node_width_mm
landscape_info <- landscape_info |>
dplyr::left_join(landscape_module, by = "landscape") |>
dplyr::left_join(module_layout |> dplyr::select(module_raw, module_y = y), by = "module_raw")
even_centers <- body_top - (seq_len(nrow(landscape_info)) - 0.5) * body_height / nrow(landscape_info)
desired_centers <- dplyr::coalesce(landscape_info$module_y, even_centers)
landscape_info$y <- place_blocks(desired_center = desired_centers, extent_above = landscape_info$photo_height / 2 + photo_label_mm, extent_below = landscape_info$photo_height / 2, top_limit = body_top, bottom_limit = body_bottom, gap = photo_gap_mm)
landscape_info <- landscape_info |>
dplyr::mutate(
photo_ymin = y - photo_height / 2,
photo_ymax = y + photo_height / 2,
bar_height = n_species * min_ribbon_mm + mm_per_record * total_records,
bar_ymin = y - bar_height / 2,
bar_ymax = y + bar_height / 2,
fill = unname(landscape_colors[landscape]),
outline = darken_color(fill),
name = landscape,
totals = paste0(total_records, " individuals - ", n_species, " species")
)
ribbons <- links |>
dplyr::left_join(species_layout |> dplyr::select(species, y_species = y), by = "species") |>
dplyr::left_join(landscape_info |> dplyr::select(landscape, y_landscape = y), by = "landscape") |>
dplyr::mutate(thickness = ribbon_thickness(n_records)) |>
dplyr::group_by(landscape) |> dplyr::arrange(dplyr::desc(y_species), .by_group = TRUE) |>
dplyr::mutate(start_top = y_landscape + sum(thickness) / 2 - cumsum(thickness) + thickness, start_bottom = start_top - thickness) |>
dplyr::ungroup() |> dplyr::group_by(species) |> dplyr::arrange(dplyr::desc(y_landscape), .by_group = TRUE) |>
dplyr::mutate(end_top = y_species + sum(thickness) / 2 - cumsum(thickness) + thickness, end_bottom = end_top - thickness) |>
dplyr::ungroup() |> dplyr::arrange(dplyr::desc(thickness)) |>
dplyr::mutate(draw_order = dplyr::row_number(), fill = unname(landscape_colors[landscape]))
ribbon_steps <- seq(0, 1, length.out = 80)
ribbon_shape <- ribbon_steps^2 * (3 - 2 * ribbon_steps)
ribbon_x <- landscape_node_xmax + (species_node_xmin - landscape_node_xmax) * ribbon_steps
ribbon_polygons <- dplyr::bind_rows(
lapply(seq_len(nrow(ribbons)), function(i) {
ribbon <- ribbons[i, ]
top_edge <- ribbon$start_top + (ribbon$end_top - ribbon$start_top) * ribbon_shape
bottom_edge <- ribbon$start_bottom + (ribbon$end_bottom - ribbon$start_bottom) * ribbon_shape
tibble::tibble(draw_order = ribbon$draw_order, fill = ribbon$fill, x = c(ribbon_x, rev(ribbon_x)), y = c(top_edge, rev(bottom_edge)))
})
)
dprime_max <- max(0.6, ceiling(max(species_layout$d_prime, na.rm = TRUE) * 5) / 5)
dprime_breaks <- seq(0, dprime_max, by = 0.2)
dprime_plot_xmin <- dprime_xmin + 1.5
dprime_plot_xmax <- dprime_xmax - 1.5
dprime_to_x <- function(d) dprime_plot_xmin + d / dprime_max * (dprime_plot_xmax - dprime_plot_xmin)
header_y <- body_top + 2.2
rule_y <- body_top + 1.0
axis_y <- body_bottom - 0.6
network_plot <- ggplot2::ggplot() +
ggplot2::geom_rect(data = module_layout, ggplot2::aes(xmin = species_node_xmin - 0.8, xmax = module_strip_xmax, ymin = ymin, ymax = ymax), fill = module_layout$module_color, alpha = module_tint_alpha, color = NA) +
ggplot2::geom_rect(data = module_layout, ggplot2::aes(xmin = module_strip_xmin, xmax = module_strip_xmax, ymin = ymin, ymax = ymax), fill = module_layout$module_color, color = NA) +
ggplot2::geom_text(data = module_layout, ggplot2::aes(x = module_strip_xmax + module_label_width / 2, y = y, label = module_label), angle = -90, size = pt_to_size(small_text_pt), family = font_family, color = "grey15") +
ggplot2::annotate("segment", x = dprime_to_x(dprime_breaks), xend = dprime_to_x(dprime_breaks), y = body_bottom, yend = body_top, color = "grey82", linewidth = mm_to_linewidth(0.15)) +
ggplot2::geom_polygon(data = ribbon_polygons, ggplot2::aes(x = x, y = y, group = draw_order, fill = fill), alpha = ribbon_alpha, color = NA) +
ggplot2::scale_fill_identity() +
ggplot2::geom_rect(data = landscape_info, ggplot2::aes(xmin = landscape_node_xmin, xmax = landscape_node_xmax, ymin = bar_ymin, ymax = bar_ymax), fill = landscape_info$fill, color = landscape_info$outline, linewidth = mm_to_linewidth(node_outline_mm)) +
ggplot2::geom_rect(data = species_layout, ggplot2::aes(xmin = species_node_xmin, xmax = species_node_xmax, ymin = bar_ymin, ymax = bar_ymax), fill = "grey65", color = "grey25", linewidth = mm_to_linewidth(node_outline_mm)) +
ggplot2::geom_text(data = species_layout, ggplot2::aes(x = species_label_x, y = y, label = label), parse = TRUE, hjust = 0, vjust = 0.5, size = pt_to_size(species_text_pt), family = font_family, color = "black") +
ggplot2::geom_text(data = species_layout, ggplot2::aes(x = records_x, y = y, label = total_records), hjust = 1, vjust = 0.5, size = pt_to_size(small_text_pt), family = font_family, color = "grey20") +
ggplot2::geom_segment(data = species_layout, ggplot2::aes(x = dprime_to_x(0), xend = dprime_to_x(d_prime), y = y, yend = y), color = "grey45", linewidth = mm_to_linewidth(0.35), lineend = "butt") +
ggplot2::geom_point(data = species_layout, ggplot2::aes(x = dprime_to_x(d_prime), y = y), shape = 21, size = 1.8, stroke = 0.35, fill = species_layout$module_color, color = darken_color(species_layout$module_color, 0.55)) +
ggplot2::annotate("segment", x = dprime_to_x(0), xend = dprime_to_x(dprime_max), y = axis_y, yend = axis_y, color = "grey25", linewidth = mm_to_linewidth(0.25)) +
ggplot2::annotate("segment", x = dprime_to_x(dprime_breaks), xend = dprime_to_x(dprime_breaks), y = axis_y, yend = axis_y - 0.9, color = "grey25", linewidth = mm_to_linewidth(0.25)) +
ggplot2::annotate("text", x = dprime_to_x(dprime_breaks), y = axis_y - 1.4, label = formatC(dprime_breaks, format = "f", digits = 1), vjust = 1, size = pt_to_size(small_text_pt), family = font_family, color = "grey15") +
ggplot2::annotate("segment", x = species_node_xmin - 0.8, xend = module_strip_xmax, y = rule_y, yend = rule_y, color = "grey30", linewidth = mm_to_linewidth(0.25)) +
ggplot2::annotate("text", x = c(photo_xmin, species_label_x, records_x, (dprime_xmin + dprime_xmax) / 2), y = header_y, label = c(landscape_header, species_header, records_header, dprime_header), hjust = c(0, 0, 1, 0.5), vjust = 0, size = pt_to_size(header_text_pt), family = font_family, fontface = "bold")
for (i in seq_len(nrow(landscape_info))) {
landscape_label <- landscape_info$name[i]
photos <- landscape_photos[[landscape_label]]
if (length(photos) == 0) {
network_plot <- network_plot + ggplot2::annotate("rect", xmin = photo_xmin, xmax = photo_xmax, ymin = landscape_info$photo_ymin[i], ymax = landscape_info$photo_ymax[i], fill = "grey95", color = NA)
} else {
current_top <- landscape_info$photo_ymax[i]
for (img in photos) {
img_height <- photo_width_mm * dim(img)[1] / dim(img)[2]
network_plot <- network_plot + ggplot2::annotation_custom(grid::rasterGrob(img, width = grid::unit(1, "npc"), height = grid::unit(1, "npc"), interpolate = TRUE), xmin = photo_xmin, xmax = photo_xmax, ymin = current_top - img_height, ymax = current_top)
current_top <- current_top - img_height - photo_inner_gap_mm
}
}
label_expression <- paste0("bold(\"", landscape_info$name[i], "\")")
network_plot <- network_plot +
ggplot2::annotate("rect", xmin = photo_xmin, xmax = photo_xmax, ymin = landscape_info$photo_ymin[i], ymax = landscape_info$photo_ymax[i], fill = NA, color = landscape_info$fill[i], linewidth = mm_to_linewidth(frame_line_mm), linejoin = "mitre") +
ggplot2::annotate("text", x = photo_xmin, y = landscape_info$photo_ymax[i] + 4.0, label = label_expression, parse = TRUE, hjust = 0, vjust = 0, size = pt_to_size(landscape_text_pt), family = font_family, color = "black") +
ggplot2::annotate("text", x = photo_xmin, y = landscape_info$photo_ymax[i] + 1.0, label = landscape_info$totals[i], hjust = 0, vjust = 0, size = pt_to_size(small_text_pt), family = font_family, color = "grey30")
}
record_breaks <- c(1, 10, 50, 100, 500, 1000)
record_breaks <- record_breaks[record_breaks <= max(links$n_records)]
if (length(record_breaks) > 4) record_breaks <- c(1, utils::tail(record_breaks, 3))
key_title_width <- measure_label_width_mm(ribbon_key_title, font_family, small_text_pt, parse = FALSE)
key_x <- landscape_node_xmax + 2.0
key_center_y <- body_bottom - 2.0 - ribbon_thickness(max(record_breaks)) / 2
key_bar_width <- node_width_mm
key_step <- 9.0
key_positions <- key_x + key_title_width + 5.0 + (seq_along(record_breaks) - 1) * key_step
network_plot <- network_plot +
ggplot2::annotate("text", x = key_x, y = key_center_y, label = ribbon_key_title, hjust = 0, vjust = 0.5, size = pt_to_size(small_text_pt), family = font_family, fontface = "bold", color = "grey15") +
ggplot2::annotate("rect", xmin = key_positions, xmax = key_positions + key_bar_width, ymin = key_center_y - ribbon_thickness(record_breaks) / 2, ymax = key_center_y + ribbon_thickness(record_breaks) / 2, fill = "grey55", color = NA) +
ggplot2::annotate("text", x = key_positions + key_bar_width + 1.0, y = key_center_y, label = format(record_breaks, big.mark = ",", trim = TRUE), hjust = 0, vjust = 0.5, size = pt_to_size(small_text_pt), family = font_family, color = "grey15")
if (show_network_metrics) {
metrics_expression <- paste0(
"H[2]*\"'\" == \"", sprintf("%.2f", obs_net_metrics["H2"]), "\"~\"(\"*",
format_p_expression(p_val_H2, null_model_iterations), "*\")\"*\";\"~~",
"italic(Q) == \"", sprintf("%.2f", mod_Q), "\"*\";\"~~",
"italic(C) == \"", sprintf("%.2f", obs_net_metrics["connectance"]), "\"*\";\"~~",
"wNODF == \"", sprintf("%.1f", obs_net_metrics["weighted NODF"]), "\"~\"(\"*",
format_p_expression(p_val_wNODF, null_model_iterations), "*\")\""
)
network_plot <- network_plot +
ggplot2::annotate("text", x = photo_xmin, y = margin_mm + 0.6, label = metrics_expression, parse = TRUE, hjust = 0, vjust = 0, size = pt_to_size(small_text_pt), family = font_family, color = "grey15")
}
network_plot <- network_plot +
ggplot2::coord_fixed(ratio = 1, xlim = c(0, figure_width_mm), ylim = c(0, figure_height_mm), expand = FALSE, clip = "off") +
ggplot2::theme_void(base_family = font_family) +
ggplot2::theme(plot.background = ggplot2::element_rect(fill = background_color, color = NA), panel.background = ggplot2::element_rect(fill = background_color, color = NA), plot.margin = ggplot2::margin(0, 0, 0, 0), legend.position = "none")
suffix_name <- if (use_all_methods) "all_methods" else "suspension_only"
output_base <- file.path(output_directory, paste0("Figure_bipartite_quantitative_", suffix_name, "_v2"))
output_png <- paste0(output_base, ".png")
output_pdf <- paste0(output_base, ".pdf")
ragg::agg_png(filename = output_png, width = figure_width_mm, height = figure_height_mm, units = "mm", res = export_dpi, background = background_color)
tryCatch(print(network_plot), finally = grDevices::dev.off())
if (capabilities("cairo")) {
grDevices::cairo_pdf(filename = output_pdf, width = figure_width_mm / 25.4, height = figure_height_mm / 25.4, bg = background_color, family = font_family)
} else {
grDevices::pdf(file = output_pdf, width = figure_width_mm / 25.4, height = figure_height_mm / 25.4, bg = background_color, useDingbats = FALSE)
}
tryCatch(print(network_plot), finally = grDevices::dev.off())
cat("\nAnalysis completed successfully.\n\n")
pkgs <- c("dplyr", "tidyr", "readr", "stringr", "tibble", "janitor",
"vegan", "indicspecies", "permute", "ggplot2", "ggdist",
"patchwork", "forcats", "scales", "ragg")
suppressPackageStartupMessages(invisible(lapply(pkgs, library, character.only = TRUE)))
set.seed(123)
fig_w <- 180
alpha_h <- 230
ind_h <- 120
dpi_val <- 600
ffam <- "sans"
# Atualizacao das Nomenclaturas (Cerrado, Floodplain, Pantanal)
lcols <- c(
"Cerrado" = "#C89A42",
"Floodplain" = "#6CA0E8",
"Pantanal" = "#4E9B73",
"Cerrado + Pantanal" = "#8B9A5A",
"Cerrado + Floodplain" = "#9A9C95",
"Floodplain + Pantanal" = "#5C9EAC",
"Cerrado + Floodplain + Pantanal" = "#6E6E6E"
)
reqs <- c("Cerrado", "Floodplain", "Pantanal")
mm_lw <- function(mm) mm / (ggplot2::.pt * 25.4 / 96)
pt_sz <- function(pt) pt / ggplot2::.pt
dk_col <- function(col, f = 0.55) {
grDevices::rgb(t((grDevices::col2rgb(col) / 255) * f))
}
ntxt <- function(x) {
tolower(stringr::str_squish(iconv(as.character(x), "", "ASCII//TRANSLIT")))
}
ctxt <- function(x) {
stringr::str_squish(as.character(x))
}
# ======================================================================
# ATUALIZADO: Usando o diretorio exato
# ======================================================================
output_directory <- normalizePath(
"C:/Users/João Marcos/Desktop/DOUTORADO/analises/Not all paper dissolves in water social wasps/material_suplementar/SOCIAL WASPS - ANALYSES ok/results_pointlevel_valid_v2",
winslash = "/",
mustWork = FALSE
)
dir.create(output_directory, recursive = TRUE, showWarnings = FALSE)
if (interactive()) {
message("Selecione o arquivo CSV da sua base de dados (ex: dados_utf8.csv)")
fcsv <- normalizePath(file.choose(), winslash = "/", mustWork = TRUE)
} else {
fcsv <- "dados_utf8.csv.csv"
}
raw <- readr::read_delim(
fcsv,
";",
locale = readr::locale(encoding = "UTF-8"),
show_col_types = FALSE,
trim_ws = TRUE
) |> janitor::clean_names()
# Processamento MANTENDO APENAS OS PONTOS COM REGISTROS, COMO NO MANUSCRITO
raw_susp <- raw |>
dplyr::filter(stringr::str_detect(ntxt(trap), "susp")) |>
dplyr::mutate(
point = ctxt(point),
lati_s = ctxt(lati_s),
long_w = ctxt(long_w),
land_l = ntxt(landscape),
landscape_class = dplyr::case_when(
stringr::str_detect(land_l, "pant") | stringr::str_detect(ntxt(point), "baia negra") ~ "Pantanal",
stringr::str_detect(land_l, "cerr") | stringr::str_detect(ntxt(point), "bodoquena") ~ "Cerrado",
stringr::str_detect(land_l, "flood|varzea") | stringr::str_detect(ntxt(point), "pevri|ivinhema") ~ "Floodplain",
TRUE ~ NA_character_
),
area_name = dplyr::case_when(
landscape_class == "Pantanal" ~ "Baia Negra",
landscape_class == "Cerrado" ~ "Serra da Bodoquena",
landscape_class == "Floodplain" ~ "PEVRI",
TRUE ~ point
),
point_id = paste(area_name, lati_s, long_w, sep = " | "),
date_s = dplyr::if_else(is.na(date) | ctxt(date) == "", "NO_DATE", ctxt(date)),
event_id = paste(point_id, date_s, sep = " || "),
species = ctxt(species)
) |>
dplyr::filter(!is.na(landscape_class))
# Extrai APENAS os registros validos das iscas suspensas (ignora os 2 pontos vazios)
susp_rec <- raw_susp |>
dplyr::filter(!is.na(species), species != "") |>
dplyr::distinct(point_id, event_id, landscape_class, area_name, date_s, species, .keep_all = TRUE)
# Tabela com as capturas (ja vai ter naturalmente apenas 46 pontos)
pt_freq_df <- susp_rec |>
dplyr::count(point_id, species, name = "rf") |>
tidyr::pivot_wider(names_from = species, values_from = rf, values_fill = 0) |>
dplyr::left_join(
susp_rec |> dplyr::distinct(point_id, landscape_class, area_name),
by = "point_id"
) |>
dplyr::mutate(dplyr::across(where(is.numeric), ~tidyr::replace_na(., 0))) |>
dplyr::arrange(match(landscape_class, reqs), point_id)
sp_cols <- setdiff(names(pt_freq_df), c("point_id", "landscape_class", "area_name"))
fmat <- as.data.frame(pt_freq_df[, sp_cols, drop = FALSE], check.names = FALSE)
rownames(fmat) <- pt_freq_df[["point_id"]]
pmat <- as.data.frame(lapply(fmat, function(x) ifelse(x > 0, 1, 0)), check.names = FALSE)
rownames(pmat) <- rownames(fmat)
grp_pt <- factor(pt_freq_df[["landscape_class"]], levels = reqs)
alpha_df <- tibble::tibble(
point_id = pt_freq_df[["point_id"]],
landscape_class = grp_pt,
record_frequency = rowSums(fmat),
richness = rowSums(fmat > 0),
shannon = vegan::diversity(fmat, index = "shannon")
)
set.seed(123)
alpha_df <- alpha_df |>
dplyr::mutate(
x_num = as.numeric(landscape_class),
x_jit = x_num - 0.18 + stats::runif(dplyr::n(), -0.055, 0.055),
out_col = dk_col(unname(lcols[as.character(landscape_class)]), 0.52)
)
n_land <- table(alpha_df[["landscape_class"]])
xlabs_n <- sprintf("%s\n(n = %d)", names(n_land), as.integer(n_land))
mk_panel <- function(yvar, ylab, tag, ttl, ybrk, show_x = FALSE) {
kt <- stats::kruskal.test(alpha_df[[yvar]] ~ alpha_df[["landscape_class"]])
sub_txt <- sprintf(
"Kruskal-Wallis: H = %.2f, df = %d, p = %.4f",
unname(kt[["statistic"]]), as.integer(kt[["parameter"]]), kt[["p.value"]]
)
if (kt[["p.value"]] < 0.05) {
if (yvar %in% c("richness", "shannon")) {
lets <- c("Cerrado" = "b", "Floodplain" = "a", "Pantanal" = "ab")
} else {
lets <- c("Cerrado" = "a", "Floodplain" = "a", "Pantanal" = "a")
}
} else {
lets <- c("Cerrado" = "", "Floodplain" = "", "Pantanal" = "")
}
yv <- alpha_df[[yvar]]
ysp <- max(yv) - min(yv)
if (ysp == 0) ysp <- 1
ldf <- alpha_df |>
dplyr::group_by(landscape_class, x_num) |>
dplyr::summarise(ty = max(.data[[yvar]]), .groups = "drop") |>
dplyr::mutate(
let = unname(lets[as.character(landscape_class)]),
ly = ty + ysp * 0.14
)
ggplot2::ggplot(alpha_df, ggplot2::aes(x = x_num, y = .data[[yvar]], fill = landscape_class, group = landscape_class)) +
ggdist::stat_halfeye(
position = ggplot2::position_nudge(x = 0.12),
adjust = 0.80, width = 0.44, .width = 0, justification = 0,
point_colour = NA, alpha = 0.55, color = "grey30", slab_linewidth = mm_lw(0.24)
) +
ggplot2::geom_boxplot(
width = 0.16, outlier.shape = NA, alpha = 0.72,
color = "grey15", linewidth = mm_lw(0.35)
) +
ggplot2::stat_summary(
fun = mean, geom = "point", shape = 23, size = 2.9,
fill = "white", color = "grey10", stroke = 0.70
) +
ggplot2::geom_point(
ggplot2::aes(x = x_jit, y = .data[[yvar]], fill = landscape_class),
inherit.aes = FALSE, shape = 21, size = 2.3, stroke = 0.40,
alpha = 0.88, color = alpha_df[["out_col"]]
) +
ggplot2::geom_text(
data = ldf, ggplot2::aes(x = x_num, y = ly, label = let),
inherit.aes = FALSE, family = ffam, fontface = "bold",
size = pt_sz(11.8), color = "grey10"
) +
ggplot2::scale_fill_manual(values = lcols) +
ggplot2::scale_x_continuous(
breaks = 1:3, labels = xlabs_n, limits = c(0.55, 3.60), expand = c(0, 0)
) +
ggplot2::scale_y_continuous(
breaks = ybrk, expand = ggplot2::expansion(mult = c(0.06, 0.25))
) +
ggplot2::labs(title = paste0(tag, "  ", ttl), subtitle = sub_txt, x = NULL, y = ylab) +
ggplot2::theme_classic(base_size = 12, base_family = ffam) +
ggplot2::theme(
legend.position = "none",
plot.title = ggplot2::element_text(face = "bold", size = 13.5, hjust = 0, color = "black", margin = ggplot2::margin(b = 2)),
plot.subtitle = ggplot2::element_text(size = 11.2, hjust = 0, color = "grey20", margin = ggplot2::margin(b = 6)),
axis.title.y = ggplot2::element_text(face = "bold", size = 12.2, color = "black", margin = ggplot2::margin(r = 7)),
axis.text.y = ggplot2::element_text(size = 11.0, color = "grey15"),
axis.text.x = if (show_x) ggplot2::element_text(face = "bold", size = 12.2, color = "black", lineheight = 1.08, margin = ggplot2::margin(t = 5)) else ggplot2::element_blank(),
axis.ticks.x = if (show_x) ggplot2::element_line(linewidth = mm_lw(0.30), color = "grey20") else ggplot2::element_blank(),
axis.line = ggplot2::element_line(linewidth = mm_lw(0.35), color = "grey20"),
panel.grid.major.y = ggplot2::element_line(color = "grey92", linewidth = mm_lw(0.22)),
plot.margin = ggplot2::margin(t = 4, r = 8, b = 4, l = 6)
)
}
p_ri <- mk_panel("richness", "Species richness", "A", "Species richness", 1:7, FALSE)
p_sh <- mk_panel("shannon", "Shannon index (H')", "B", "Shannon diversity", seq(0, 2, 0.5), FALSE)
p_rf <- mk_panel("record_frequency", "Record frequency", "C", "Record frequency", 1:7, TRUE)
alpha_panel <- (p_ri / p_sh / p_rf) +
patchwork::plot_annotation(
theme = ggplot2::theme(
plot.margin = ggplot2::margin(t = 6, r = 8, b = 6, l = 8),
plot.background = ggplot2::element_rect(fill = "white", color = NA)
)
)
# Ajuste do IndVal: Combinacoes (duleg = FALSE) e Correcao BH
set.seed(123)
ind_res <- indicspecies::multipatt(
fmat, grp_pt, func = "IndVal.g", duleg = FALSE,
control = permute::how(nperm = 9999)
)
occ_u <- tibble::tibble(
species = colnames(pmat),
occupied_units = as.integer(colSums(pmat))
)
comb_mat <- ind_res$sign[, 1:length(reqs)]
comb_names <- apply(comb_mat, 1, function(x) paste(reqs[x == 1], collapse = " + "))
ind_df <- as.data.frame(ind_res[["sign"]]) |>
tibble::rownames_to_column("species") |>
dplyr::rename(index_stat = stat, p_value = p.value) |>
dplyr::mutate(
p_adj = stats::p.adjust(p_value, method = "BH"),
landscape_class = comb_names
) |>
dplyr::filter(p_adj <= 0.05) |>
dplyr::left_join(occ_u, by = "species") |>
dplyr::mutate(
species = forcats::fct_reorder(species, index_stat),
p_format = ifelse(
p_adj < 0.001,
"< 0.001",
sprintf("= %s", formatC(p_adj, format = "f", digits = 3))
),
stat_label = sprintf("%.2f (p %s; U = %d)", index_stat, p_format, occupied_units),
out_col = dk_col(unname(lcols[landscape_class]), 0.55)
)
indicator_plot <- ggplot2::ggplot(ind_df, ggplot2::aes(x = index_stat, y = species, color = landscape_class, fill = landscape_class)) +
ggplot2::geom_vline(xintercept = seq(0, 1.0, 0.2), color = "grey90", linewidth = mm_lw(0.24)) +
ggplot2::geom_hline(yintercept = seq_len(nrow(ind_df)), color = "grey95", linewidth = mm_lw(0.20), linetype = "dashed") +
ggplot2::geom_segment(ggplot2::aes(x = 0, xend = index_stat, y = species, yend = species), linewidth = mm_lw(1.45), alpha = 0.90, lineend = "butt") +
ggplot2::geom_point(shape = 21, size = 4.6, stroke = 0.65, color = ind_df[["out_col"]]) +
ggplot2::geom_text(
ggplot2::aes(x = index_stat + 0.025, label = stat_label),
hjust = 0, vjust = 0.5, size = pt_sz(10.8), fontface = "bold",
color = "grey15", family = ffam
) +
ggplot2::scale_color_manual(values = lcols, name = NULL) +
ggplot2::scale_fill_manual(values = lcols, name = NULL) +
ggplot2::scale_x_continuous(breaks = seq(0, 1.0, 0.2), limits = c(0, 1.40), expand = c(0, 0)) +
ggplot2::scale_y_discrete(expand = ggplot2::expansion(add = c(0.58, 0.58))) +
ggplot2::labs(x = "Indicator value (IndVal.g)", y = NULL) +
ggplot2::theme_classic(base_size = 12, base_family = ffam) +
ggplot2::theme(
axis.text.y = ggplot2::element_text(face = "italic", size = 12.5, color = "black", margin = ggplot2::margin(r = 4)),
axis.text.x = ggplot2::element_text(size = 11.2, color = "grey15"),
axis.title.x = ggplot2::element_text(face = "bold", size = 12.5, color = "black", margin = ggplot2::margin(t = 7)),
axis.line = ggplot2::element_line(linewidth = mm_lw(0.35), color = "grey20"),
legend.position = "top",
legend.justification = "center",
legend.text = ggplot2::element_text(face = "bold", size = 12.2, color = "black"),
legend.key.size = grid::unit(5.5, "mm"),
legend.margin = ggplot2::margin(b = 2),
plot.margin = ggplot2::margin(t = 8, r = 10, b = 8, l = 8)
) +
ggplot2::coord_cartesian(clip = "off")
save_pub <- function(plt, fn, w, h) {
base <- file.path(output_directory, fn)
ragg::agg_png(
paste0(base, ".png"), w, h, "mm",
res = dpi_val, background = "white"
)
print(plt)
grDevices::dev.off()
if (capabilities("cairo")) {
grDevices::cairo_pdf(
paste0(base, ".pdf"), w / 25.4, h / 25.4,
bg = "white", family = ffam
)
} else {
grDevices::pdf(
paste0(base, ".pdf"), w / 25.4, h / 25.4,
bg = "white", useDingbats = FALSE
)
}
print(plt)
grDevices::dev.off()
}
save_pub(alpha_panel, "01_alpha_diversity_panel_suspension_pointlevel_v2", fig_w, alpha_h)
save_pub(indicator_plot, "03_indicator_species_lollipop_suspension_pointlevel_v2", fig_w, ind_h)
cat("\nConcluido! Figuras salvas com as novas padronizacoes.\n")
cat("Pontos analisados:", nrow(alpha_df), "\n")
