# 2. Processamento para gerar a Tabela Suplementar S3
tabela_suplementar <- dados_brutos %>%
filter(trap == "suspension") %>%
mutate(Coordenadas = paste(lati_s, long_w, sep = ", ")) %>%
group_by(landscape, Coordenadas) %>%
summarise(
Fisionomia = first(classification),
Data_de_Instalacao = "[Preencher]",
