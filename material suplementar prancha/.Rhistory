col = "#C89A42",
imgs = im_cerr
),
list(
tag = "c",
title = "Parque Estadual das Várzeas do Rio Ivinhema — RF",
sub = "Coordinates: 22°55'07\"S, 53°39'11\"W   ·   73,345.15 ha",
col = "#6CA0E8",
imgs = im_floo
)
)
plt <- ggplot2::ggplot()
cursor_y <- fig_h
for (k in seq_along(specs)) {
sp <- specs[[k]]
head_top <- cursor_y
photo_top <- head_top - header_h
photo_bot <- photo_top - photo_h
plt <- plt +
ggplot2::annotate(
"rect",
xmin = x_left_min,
xmax = x_left_min + 8.0,
ymin = photo_top + 1.8,
ymax = photo_top + 9.8,
fill = sp[["col"]],
color = NA
) +
ggplot2::annotate(
"text",
x = x_left_min + 4.0,
y = photo_top + 5.8,
label = sp[["tag"]],
family = ffam,
fontface = "bold",
size = pt_sz(12.0),
color = "white",
hjust = 0.5,
vjust = 0.5
) +
ggplot2::annotate(
"text",
x = x_left_min + 10.2,
y = photo_top + 6.0,
label = sp[["title"]],
family = ffam,
fontface = "bold",
size = pt_sz(11.2),
color = "black",
hjust = 0,
vjust = 0
) +
ggplot2::annotate(
"text",
x = x_left_min + 10.2,
y = photo_top + 1.8,
label = sp[["sub"]],
family = ffam,
size = pt_sz(9.5),
color = "grey25",
hjust = 0,
vjust = 0
) +
ggplot2::annotation_custom(
grid::rasterGrob(sp[["imgs"]][["left"]], width = grid::unit(1, "npc"), height = grid::unit(1, "npc"), interpolate = TRUE),
xmin = x_left_min, xmax = x_left_max, ymin = photo_bot, ymax = photo_top
) +
ggplot2::annotation_custom(
grid::rasterGrob(sp[["imgs"]][["right"]], width = grid::unit(1, "npc"), height = grid::unit(1, "npc"), interpolate = TRUE),
xmin = x_right_min, xmax = x_right_max, ymin = photo_bot, ymax = photo_top
) +
ggplot2::annotate(
"rect",
xmin = x_left_min, xmax = x_left_max, ymin = photo_bot, ymax = photo_top,
fill = NA, color = sp[["col"]], linewidth = mm_lw(0.65), linejoin = "mitre"
) +
ggplot2::annotate(
"rect",
xmin = x_right_min, xmax = x_right_max, ymin = photo_bot, ymax = photo_top,
fill = NA, color = sp[["col"]], linewidth = mm_lw(0.65), linejoin = "mitre"
)
if (k < length(specs)) {
div_y <- photo_bot - block_gap / 2
plt <- plt +
ggplot2::annotate(
"segment",
x = x_left_min, xend = x_right_max, y = div_y, yend = div_y,
color = "grey82", linewidth = mm_lw(0.25)
)
}
cursor_y <- photo_bot - block_gap
}
plt <- plt +
ggplot2::coord_fixed(ratio = 1, xlim = c(0, fig_w), ylim = c(0, fig_h), expand = FALSE, clip = "off") +
ggplot2::theme_void(base_family = ffam) +
ggplot2::theme(
plot.background = ggplot2::element_rect(fill = "white", color = NA),
panel.background = ggplot2::element_rect(fill = "white", color = NA),
plot.margin = ggplot2::margin(0, 0, 0, 0)
)
if (interactive()) {
grDevices::dev.new(width = fig_w / 25.4, height = fig_h / 25.4, unit = "in", noRStudioGD = TRUE)
print(plt)
grDevices::dev.flush()
}
out_base <- file.path(wdir, "Supplementary_Figure_S1_Landscapes")
ragg::agg_png(paste0(out_base, ".png"), fig_w, fig_h, "mm", res = dpi_val, background = "white"); print(plt); grDevices::dev.off()
if (capabilities("cairo")) grDevices::cairo_pdf(paste0(out_base, ".pdf"), fig_w / 25.4, fig_h / 25.4, bg = "white", family = ffam) else grDevices::pdf(paste0(out_base, ".pdf"), fig_w / 25.4, fig_h / 25.4, bg = "white", useDingbats = FALSE)
print(plt); grDevices::dev.off()
cat(sprintf("\nPrancha S1 concluida com novas siglas e arquivos (%.0f x %.0f mm, %d dpi) em:\n%s\n", fig_w, fig_h, dpi_val, wdir))
