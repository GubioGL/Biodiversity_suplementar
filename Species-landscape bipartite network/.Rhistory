normalized_value <- normalize_text(x)
dplyr::case_when(
stringr::str_detect(normalized_value, "pant") ~ "P",
stringr::str_detect(normalized_value, "cerr") ~ "SDF",
stringr::str_detect(normalized_value, "flood|varzea|ivinhema|pevri") ~ "RF",
TRUE ~ NA_character_
)
}
safe_read_image <- function(image_path) {
extension <- tolower(tools::file_ext(image_path))
tryCatch(
{
if (extension == "png") png::readPNG(image_path)
else if (extension %in% c("jpg", "jpeg")) jpeg::readJPEG(image_path)
else if (extension %in% c("tif", "tiff")) tiff::readTIFF(image_path)
else NULL
},
error = function(e) {
warning("The image could not be read: ", basename(image_path), ". ", conditionMessage(e))
NULL
}
)
}
find_landscape_images <- function(image_files, landscape_label, maximum_number = 2) {
if (length(image_files) == 0) return(character(0))
aliases <- switch(
landscape_label,
"P" = c("pantanal", "baia negra", "baianegra", "apa baia negra"),
"SDF" = c("cerrado", "bodoquena", "serra da bodoquena"),
"RF" = c("floodplain", "varzea", "varzeas", "ivinhema", "rio ivinhema", "pevri"),
character(0)
)
aliases <- vapply(aliases, normalize_file_name, character(1))
normalized_names <- vapply(image_files, normalize_file_name, character(1))
root_bonus <- ifelse(
normalize_path_safe(dirname(image_files)) == normalize_path_safe(image_directory),
5000, 0
)
image_scores <- vapply(
seq_along(image_files),
function(i) {
current_name <- normalized_names[i]
alias_scores <- vapply(aliases, function(alias) {
if (identical(current_name, alias)) return(10000 + nchar(alias))
if (grepl(alias, current_name, fixed = TRUE)) return(1000 + nchar(alias))
0
}, numeric(1))
max(alias_scores) + root_bonus[i]
}, numeric(1)
)
matched_positions <- which(image_scores > root_bonus)
if (length(matched_positions) == 0) return(character(0))
matched_positions <- matched_positions[order(-image_scores[matched_positions], basename(image_files[matched_positions]))]
selected_files <- unique(image_files[matched_positions])
head(normalizePath(selected_files, winslash = "/", mustWork = TRUE), maximum_number)
}
pick_font_family <- function(candidates) {
installed <- tryCatch(unique(systemfonts::system_fonts()$family), error = function(e) character(0))
found <- candidates[candidates %in% installed]
if (length(found) > 0) found[1] else "sans"
}
mm_to_linewidth <- function(mm) mm / (ggplot2::.pt * 25.4 / 96)
pt_to_size <- function(pt) pt / ggplot2::.pt
darken_color <- function(color, factor = 0.70) {
rgb_values <- grDevices::col2rgb(color) / 255
grDevices::rgb(t(rgb_values * factor))
}
format_taxon_label <- function(taxa) {
upright_pattern <- "^(sp|spp|cf|aff|nr|gr|var|ssp|subsp|morpho)\\.?$|^[0-9]+$|^[A-Z][0-9]*$"
quote_token <- function(token) {
token <- gsub("\\\\", "\\\\\\\\", token)
token <- gsub("\"", "\\\\\"", token)
paste0("\"", token, "\"")
}
vapply(
taxa,
function(taxon) {
tokens <- strsplit(stringr::str_squish(taxon), " ", fixed = TRUE)[[1]]
pieces <- vapply(
tokens,
function(token) {
if (grepl("^\\(.+\\)$", token)) {
inner <- sub("^\\((.+)\\)$", "\\1", token)
paste0("\"(\"*italic(", quote_token(inner), ")*\")\"")
} else if (grepl(upright_pattern, token)) {
quote_token(token)
} else {
paste0("italic(", quote_token(token), ")")
}
},
character(1)
)
paste(pieces, collapse = "~")
},
character(1),
USE.NAMES = FALSE
)
}
measure_label_width_mm <- function(labels, font_family, font_pt, parse = TRUE) {
measurement_file <- tempfile(fileext = ".png")
ragg::agg_png(measurement_file, width = 50, height = 50, units = "mm", res = 72)
on.exit({
grDevices::dev.off()
unlink(measurement_file)
})
vapply(
labels,
function(label) {
label_object <- if (parse) parse(text = label)[[1]] else label
text_grob <- grid::textGrob(label_object, gp = grid::gpar(fontsize = font_pt, fontfamily = font_family))
grid::convertWidth(grid::grobWidth(text_grob), "mm", valueOnly = TRUE)
},
numeric(1),
USE.NAMES = FALSE
)
}
read_landscape_photos <- function(image_files) {
photos <- lapply(head(image_files, 2), safe_read_image)
photos[!vapply(photos, is.null, logical(1))]
}
raw_data <- readr::read_delim(file = file_csv, delim = ";", locale = readr::locale(encoding = "UTF-8"), show_col_types = FALSE, trim_ws = TRUE)
names(raw_data) <- clean_names_safe(names(raw_data))
species_column <- pick_column(raw_data, c("species", "especie"))
landscape_column <- pick_column(raw_data, c("landscape", "paisagem", "landscape_class"))
trap_column <- pick_column(raw_data, c("trap", "armadilha", "method", "metodo"))
point_column <- pick_column(raw_data, c("point", "ponto", "local", "localidade", "area"))
analysis_data <- raw_data |>
dplyr::mutate(
species = trimws(as.character(raw_data[[species_column]])),
point = trimws(if (!is.na(point_column)) as.character(raw_data[[point_column]]) else ""),
point_key = normalize_text(point),
trap_normalized = normalize_text(as.character(raw_data[[trap_column]])),
landscape_values = if (!is.na(landscape_column)) as.character(raw_data[[landscape_column]]) else "",
landscape = dplyr::case_when(
!is.na(landscape_values) & trimws(landscape_values) != "" ~ standardize_landscape(landscape_values),
stringr::str_detect(point_key, "baia negra|baia_negra|baianegra") ~ "P",
stringr::str_detect(point_key, "bodoquena") ~ "SDF",
stringr::str_detect(point_key, "pevri|ivinhema|varzea") ~ "RF",
TRUE ~ NA_character_
),
method_group = dplyr::case_when(
stringr::str_detect(trap_normalized, "susp") ~ "Suspension",
stringr::str_detect(trap_normalized, "mala") ~ "Malaise",
stringr::str_detect(trap_normalized, "puc") ~ "Puçá",
TRUE ~ NA_character_
)
) |>
dplyr::filter(
!is.na(species), species != "",
!is.na(landscape), landscape %in% landscape_order,
!is.na(method_group), method_group %in% c("Suspension", "Malaise", "Puçá")
)
if (!use_all_methods) analysis_data <- analysis_data |> dplyr::filter(method_group == "Suspension")
links <- analysis_data |>
dplyr::count(landscape, species, name = "n_records") |>
dplyr::filter(n_records > 0)
cat("\n--- INICIANDO ANÁLISES QUANTITATIVAS DA REDE ---\n")
web_matrix <- links |>
tidyr::pivot_wider(names_from = landscape, values_from = n_records, values_fill = list(n_records = 0)) |>
tibble::column_to_rownames("species") |>
as.matrix()
cat("Calculando métricas estruturais...\n")
obs_net_metrics <- bipartite::networklevel(web_matrix, index = c("connectance", "H2", "weighted NODF"))
cat("Calculando Índice de Especialização (d') por espécie...\n")
d_species <- bipartite::specieslevel(web_matrix, level = "lower", index = "d")
species_d_df <- data.frame(Species = rownames(d_species), d_prime = d_species$d) |> dplyr::arrange(dplyr::desc(d_prime))
cat("\nTABELA DE ESPECIALIZAÇÃO d' (VALORES PARA INSERIR NO TEXTO):\n")
print(species_d_df)
cat("\n")
cat("Executando algoritmo QuanBiMo para Modularidade...\n")
mod_result <- bipartite::computeModules(web_matrix)
mod_Q <- mod_result@likelihood
cat(sprintf("Valor da Modularidade (Q): %f\n", mod_Q))
cat(sprintf("Simulando Modelos Nulos (N = %d) para teste de significância probabilística...\n", null_model_iterations))
null_webs <- bipartite::nullmodel(web_matrix, N = null_model_iterations, method = "vaznull")
null_H2 <- sapply(null_webs, function(w) bipartite::networklevel(w, index = "H2"))
null_wNODF <- sapply(null_webs, function(w) bipartite::networklevel(w, index = "weighted NODF"))
p_val_H2 <- sum(null_H2 >= obs_net_metrics["H2"]) / length(null_H2)
p_val_wNODF <- sum(null_wNODF >= obs_net_metrics["weighted NODF"]) / length(null_wNODF)
network_metrics_df <- data.frame(
Metric = c("Connectance", "Network_Specialization_H2", "Weighted_Nestedness_WNODF", "Modularity_Q"),
Observed_Value = c(obs_net_metrics["connectance"], obs_net_metrics["H2"], obs_net_metrics["weighted NODF"], mod_Q),
P_Value_Null_Model = c(NA, p_val_H2, p_val_wNODF, NA)
)
print(network_metrics_df)
cat("--- ANÁLISES ESTOCÁSTICAS CONCLUÍDAS ---\n\n")
font_family <- pick_font_family(font_candidates)
cat("Font family used in the figure: ", font_family, "\n", sep = "")
permutations_of <- function(x) {
if (length(x) <= 1) return(list(x))
result <- list()
for (i in seq_along(x)) {
for (rest in permutations_of(x[-i])) result[[length(result) + 1]] <- c(x[i], rest)
}
result
}
format_p_expression <- function(p_value, iterations) {
if (is.na(p_value)) return(NA_character_)
if (p_value == 0) return(paste0("italic(P) < \"", format(1 / iterations, scientific = FALSE), "\""))
paste0("italic(P) == \"", sprintf("%.2f", p_value), "\"")
}
place_blocks <- function(desired_center, extent_above, extent_below, top_limit, bottom_limit, gap) {
center <- desired_center
n_blocks <- length(center)
center[1] <- min(center[1], top_limit - extent_above[1])
if (n_blocks > 1) {
for (j in 2:n_blocks) center[j] <- min(center[j], center[j - 1] - extent_below[j - 1] - gap - extent_above[j])
}
center[n_blocks] <- max(center[n_blocks], bottom_limit + extent_below[n_blocks])
if (n_blocks > 1) {
for (j in (n_blocks - 1):1) center[j] <- max(center[j], center[j + 1] + extent_below[j] + gap + extent_above[j + 1])
}
center
}
module_information <- bipartite::listModuleInformation(mod_result)[[2]]
module_membership <- dplyr::bind_rows(
lapply(
seq_along(module_information),
function(i) {
dplyr::bind_rows(
tibble::tibble(node = as.character(module_information[[i]][[1]]), level = "species", module_raw = i),
tibble::tibble(node = as.character(module_information[[i]][[2]]), level = "landscape", module_raw = i)
)
}
)
)
species_module <- module_membership |> dplyr::filter(level == "species") |> dplyr::select(species = node, module_raw)
landscape_module <- module_membership |> dplyr::filter(level == "landscape") |> dplyr::select(landscape = node, module_raw)
dominant_landscape <- links |>
dplyr::group_by(species) |> dplyr::slice_max(n_records, n = 1, with_ties = FALSE) |>
dplyr::ungroup() |> dplyr::select(species, dominant_landscape = landscape)
species_info <- links |>
dplyr::group_by(species) |>
dplyr::summarise(total_records = sum(n_records), n_links = dplyr::n(), .groups = "drop") |>
dplyr::left_join(species_module, by = "species") |>
dplyr::left_join(dominant_landscape, by = "species") |>
dplyr::left_join(landscape_module |> dplyr::rename(dominant_landscape = landscape, module_of_dominant = module_raw), by = "dominant_landscape") |>
dplyr::mutate(module_raw = dplyr::coalesce(module_raw, module_of_dominant)) |>
dplyr::select(-module_of_dominant)
module_ids <- sort(unique(species_info$module_raw))
module_main_landscape <- vapply(
module_ids,
function(module_id) {
member_landscapes <- landscape_module$landscape[landscape_module$module_raw == module_id]
module_links <- links[links$species %in% species_info$species[species_info$module_raw == module_id], ]
if (length(member_landscapes) > 0) module_links <- module_links[module_links$landscape %in% member_landscapes, ]
if (nrow(module_links) == 0) return(NA_character_)
totals <- tapply(module_links$n_records, module_links$landscape, sum)
names(totals)[which.max(totals)]
},
character(1)
)
arrange_network <- function(landscape_sequence) {
position <- stats::setNames(seq_along(landscape_sequence), landscape_sequence)
module_position <- vapply(
module_ids,
function(module_id) {
member_landscapes <- landscape_module$landscape[landscape_module$module_raw == module_id]
if (length(member_landscapes) > 0) return(mean(position[member_landscapes]))
module_links <- links[links$species %in% species_info$species[species_info$module_raw == module_id], ]
stats::weighted.mean(position[module_links$landscape], module_links$n_records)
},
numeric(1)
)
barycentre <- links |>
dplyr::mutate(landscape_position = unname(position[landscape])) |>
dplyr::group_by(species) |>
dplyr::summarise(barycentre = stats::weighted.mean(landscape_position, n_records), .groups = "drop")
ordered_species <- species_info |>
dplyr::left_join(barycentre, by = "species") |>
dplyr::mutate(module_position = unname(module_position[match(module_raw, module_ids)])) |>
dplyr::arrange(module_position, barycentre, dplyr::desc(total_records), species)
species_rank <- stats::setNames(seq_len(nrow(ordered_species)), ordered_species$species)
species_position <- unname(species_rank[links$species])
link_landscape_position <- unname(position[links$landscape])
crossing_matrix <- outer(species_position, species_position, "-") * outer(link_landscape_position, link_landscape_position, "-") < 0
list(
landscape_sequence = landscape_sequence,
species = ordered_species,
crossings = sum(crossing_matrix) / 2,
weighted_crossings = sum(crossing_matrix * outer(links$n_records, links$n_records)) / 2
)
}
candidate_orders <- if (optimize_landscape_order) permutations_of(landscape_order) else list(landscape_order)
arrangements <- lapply(candidate_orders, arrange_network)
landscape_order_scores <- data.frame(
landscape_order = vapply(candidate_orders, paste, character(1), collapse = " > "),
crossings = vapply(arrangements, function(a) a$crossings, numeric(1)),
weighted_crossings = vapply(arrangements, function(a) a$weighted_crossings, numeric(1)),
displacement = vapply(candidate_orders, function(o) sum(abs(match(o, landscape_order) - seq_along(o))), numeric(1)),
stringsAsFactors = FALSE
)
best_arrangement <- order(landscape_order_scores$weighted_crossings, landscape_order_scores$crossings, landscape_order_scores$displacement)[1]
landscape_order_scores$selected <- seq_len(nrow(landscape_order_scores)) == best_arrangement
arrangement <- arrangements[[best_arrangement]]
plot_landscape_order <- arrangement$landscape_sequence
root_images <- list.files(path = image_directory, pattern = "\\.(png|jpg|jpeg|tif|tiff)$", full.names = TRUE, recursive = FALSE, ignore.case = TRUE)
all_images <- list.files(path = image_directory, pattern = "\\.(png|jpg|jpeg|tif|tiff)$", full.names = TRUE, recursive = TRUE, ignore.case = TRUE)
available_images <- unique(c(root_images, all_images))
available_images <- available_images[file.exists(available_images)]
if (length(available_images) > 0) available_images <- available_images[!is_inside_directory(available_images, output_directory)]
available_images <- available_images[!grepl("^Figure_bipartite_", basename(available_images), ignore.case = TRUE)]
landscape_photos <- lapply(plot_landscape_order, function(landscape_label) {
read_landscape_photos(find_landscape_images(image_files = available_images, landscape_label = landscape_label, maximum_number = top_n_images_per_landscape))
})
names(landscape_photos) <- plot_landscape_order
photo_inner_gap_mm <- 0.6
photo_heights <- vapply(
landscape_photos,
function(photos) {
if (length(photos) == 0) return(photo_width_mm * 0.75)
heights <- vapply(photos, function(img) photo_width_mm * dim(img)[1] / dim(img)[2], numeric(1))
sum(heights) + photo_inner_gap_mm * (length(heights) - 1)
},
numeric(1)
)
landscape_info <- links |>
dplyr::group_by(landscape) |>
dplyr::summarise(total_records = sum(n_records), n_species = dplyr::n(), .groups = "drop") |>
dplyr::slice(match(plot_landscape_order, landscape)) |>
dplyr::mutate(photo_height = unname(photo_heights[landscape]))
mm_per_record_limit <- min((landscape_info$photo_height - 2 - landscape_info$n_species * min_ribbon_mm) / landscape_info$total_records)
if (mm_per_record > mm_per_record_limit) mm_per_record <- mm_per_record_limit
ribbon_thickness <- function(n) min_ribbon_mm + mm_per_record * n
species_layout <- arrangement$species |>
dplyr::mutate(
module_number = match(module_raw, unique(module_raw)),
module_label = paste("Module", as.character(utils::as.roman(module_number))),
module_landscape = unname(module_main_landscape[match(module_raw, module_ids)]),
module_color = dplyr::coalesce(unname(landscape_colors[module_landscape]), "grey60"),
bar_height = n_links * min_ribbon_mm + mm_per_record * total_records,
row_height = pmax(species_row_min_mm, bar_height + species_row_padding_mm),
label = format_taxon_label(species)
) |>
dplyr::left_join(species_d_df |> dplyr::rename(species = Species), by = "species")
number_of_modules <- length(unique(species_layout$module_number))
species_block_height <- sum(species_layout$row_height) + module_gap_mm * (number_of_modules - 1)
photo_column_height <- sum(landscape_info$photo_height + photo_label_mm) + photo_gap_mm * (nrow(landscape_info) - 1)
body_height <- max(species_block_height, photo_column_height)
title_height_mm <- if (show_title) 11 else 0
figure_height_mm <- 2 * margin_mm + title_height_mm + header_mm + body_height + footer_mm
body_top <- figure_height_mm - margin_mm - title_height_mm - header_mm
body_bottom <- body_top - body_height
cursor <- body_top - (body_height - species_block_height) / 2
species_layout$row_top <- NA_real_
species_layout$row_bottom <- NA_real_
for (i in seq_len(nrow(species_layout))) {
if (i > 1 && species_layout$module_number[i] != species_layout$module_number[i - 1]) cursor <- cursor - module_gap_mm
species_layout$row_top[i] <- cursor
cursor <- cursor - species_layout$row_height[i]
species_layout$row_bottom[i] <- cursor
}
species_layout <- species_layout |>
dplyr::mutate(
y = (row_top + row_bottom) / 2,
